# Copy the variable names, never the values, into `wix env set`.
# Secrets are stored on Wix servers (`wix env set`) and pulled locally with `wix env pull`.
# Do NOT commit real values. `.env.local` is git-ignored and managed by the Wix CLI.

# Routing provider: "google" (default) or "geoapify"
ROUTING_PROVIDER=google
# Server-side secret: provider API key (Google Maps Platform key with Geocoding API + Routes API enabled,
# or a Geoapify key). Restrict it to those APIs.
ROUTING_API_KEY=

# Secret: Geoapify key for dashboard address autocomplete (Locations, Rate simulator).
# Falls back to ROUTING_API_KEY when ROUTING_PROVIDER=geoapify.
AUTOCOMPLETE_API_KEY=

# Wix paid plan (vendor product) IDs from the App Dashboard → Pricing. Comma-separate aliases.
# Basic is the free plan and has no Wix package.
PLAN_PACKAGE_PRO=pro
PLAN_PACKAGE_BUSINESS=business

# Secret: comma-separated app instance IDs that get Pro access for development/testing.
ENTITLEMENT_OVERRIDE_INSTANCE_IDS=

# Rollout: "all" (default), "allowlist" (only ROLLOUT_ALLOWLIST), or "off" (emergency kill switch)
ROLLOUT_MODE=all
# Secret: comma-separated instance IDs for the beta allowlist.
ROLLOUT_ALLOWLIST=

# Total wall-clock budget for one checkout quote, in ms (clamped to 1500–8000).
CHECKOUT_BUDGET_MS=4000

# Optional lifecycle event delivery to Google Sheets (deployed Apps Script /exec URL).
LIFECYCLE_SHEETS_WEBHOOK_URL=
LIFECYCLE_SHEETS_WEBHOOK_SECRET=
